# ---------- required ----------
# Helius (or any Solana RPC). Helius free tier works for testing; use a paid plan at launch.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Your $PLAGUE mint address
MINT=
# Patient zero: the wallet that launched the token
DEV_WALLET=
# Owner(s) of the pool token vaults, comma separated. Tokens leaving these count as a Meteora buy.
# Add the bonding-curve vault owner AND the DAMM v2 vault owner after graduation. See README step 3.
POOL_OWNERS=

# ---------- prizes ----------
PRIZE_WALLET=
PRIZE_RESERVE_SOL=0.05
# Path to the prize wallet keypair JSON (only needed for `npm run payout -- --execute`)
PRIZE_KEYPAIR=./secrets/prize-keypair.json
SPLIT_SPREADER=0.5
SPLIT_DEEPEST=0.25
SPLIT_CURE=0.25
# Epochs start here and last EPOCH_HOURS
EPOCH_START=2026-10-10T00:00:00Z
EPOCH_HOURS=24

# ---------- game rules ----------
MIN_INFECT=1000
MIN_ACTIVE_HOLD=1000
VAX_BURN=25000

# ---------- server ----------
PORT=8080
# Domain pointing at this droplet (A record). Caddy gets HTTPS for it automatically.
API_DOMAIN=api.yourdomain.com
DB_PATH=./data/plague.db
# Your Vercel site(s), comma separated. Leave empty to allow any origin.
CORS_ORIGINS=https://your-site.vercel.app
# spl or token2022 (match how the token was created)
TOKEN_PROGRAM=spl
# Optional extra addresses to poll (e.g. the pool addresses), comma separated
EXTRA_WATCH=
# Optional: secret for the Helius webhook "Authentication header"
WEBHOOK_SECRET=
POLL_MS=4000
